# Copy to .env and fill in. Never commit .env.

# Claude research agent (https://console.anthropic.com). Leave blank to use the offline agent.
ANTHROPIC_API_KEY=

# Alpaca (https://alpaca.markets). Paper and live accounts have DIFFERENT keys.
# Start with paper keys only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: Slack / Discord incoming webhook for alerts
ALERT_WEBHOOK_URL=
